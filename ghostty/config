# Ghostty — Claude Code terminal theme (dark), glassy/translucent
# Palette matches the Claude.app terminal pane; font is Anthropic Mono @ 13pt

# Anthropic Mono (installed in ~/Library/Fonts). PragmataPro (Nerd Font build)
# then JetBrains Mono stay as fallbacks for glyphs Anthropic Mono lacks.
font-family = Anthropic Mono
font-family = PragmataPro Mono Liga
font-family = JetBrains Mono
font-size = 13

# Match VSCode: ligatures off
font-feature = -calt

# Glassy / translucent look (macOS blur behind window)
background-opacity = 0.92
background-blur-radius = 20

# Base colors — Claude Code terminal (dark), extracted from Claude.app
# background is gray-870 (#111111); selection is the app's #0099ff at 30% flattened
background = 111111
foreground = eaecf0
cursor-color = eaecf0
cursor-text = 111111
cursor-style = bar
selection-background = 0c3a58
selection-foreground = eaecf0

# ANSI palette (Claude Code terminal)
palette = 0=#262626
palette = 1=#ff3a30
palette = 2=#32d74b
palette = 3=#ffd014
palette = 4=#0099ff
palette = 5=#ff2c56
palette = 6=#b796ff
palette = 7=#a6a6a6
palette = 8=#525252
palette = 9=#ff5047
palette = 10=#32d74b
palette = 11=#ffd014
palette = 12=#0087ee
palette = 13=#ff2c56
palette = 14=#b796ff
palette = 15=#ededed

# Window chrome to match the glassy feel
macos-titlebar-style = transparent
window-padding-x = 10
window-padding-y = 8

# Default window size (columns x rows)
window-width = 120
window-height = 32

# Text rendering: no macOS thickening, and gamma-corrected blending so glyph
# weight matches how the Claude.app terminal (Chromium) renders the same font
font-thicken = false
alpha-blending = linear-corrected

# Shell integration (zsh / oh-my-zsh): prompt tracking, cwd inheritance
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Alt+arrow word-jump and readline editing
macos-option-as-alt = true

# Big scrollback for long build / Claude Code output
scrollback-limit = 100000

# Quality of life
copy-on-select = clipboard
mouse-hide-while-typing = true
window-inherit-working-directory = true

# Global dropdown terminal (summon over anything)
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Machine-local overrides — optional, untracked, per machine. Loaded last, so
# anything here wins. Display scaling differs per machine; font-size lives here
# when a machine needs one other than the default above.
config-file = ?~/.config/ghostty/config.local
